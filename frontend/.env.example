# SkillPulse LMIS - Frontend Environment Configuration
# Smart India Hackathon 2026 - Problem Statement SIH26246
#
# During local development:
# Leave VITE_API_BASE_URL empty or unset so the frontend uses the Vite dev proxy
# configured in vite.config.js (http://127.0.0.1:3000 -> http://127.0.0.1:8000).
#
# In production deployments (e.g. Vercel):
# Set VITE_API_BASE_URL in your Vercel Project Settings > Environment Variables:
# VITE_API_BASE_URL=https://skillpulse-lmis.onrender.com
VITE_API_BASE_URL=
