# SkillPulse LMIS - Environment Configuration Example
# Smart India Hackathon 2026 - Problem Statement SIH26246
#
# Copy this file to .env and provide your local credentials.
# Do not commit real keys or credentials to version control.

# Active AI Provider: "gemini" (default) or "watsonx"
AI_PROVIDER=gemini

# Common Request Timeout Boundary (in milliseconds, bounded between 5000 and 30000)
# Default is 20000 for Gemini. When using IBM watsonx with 70B models, set to 30000
# to ensure sufficient generation headroom on Lite tier infrastructure.
AI_TIMEOUT_MS=20000

# -----------------------------------------------------------------------------
# Google Gemini Configuration
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=LOW

# -----------------------------------------------------------------------------
# IBM watsonx.ai Configuration (Optional Secondary Provider)
# -----------------------------------------------------------------------------
# IBM Cloud IAM API Key
WATSONX_API_KEY=

# Regional Service Endpoint URL (configured for London region)
WATSONX_URL=https://eu-gb.ml.cloud.ibm.com

# watsonx.ai Project UUID (from your watsonx project settings)
WATSONX_PROJECT_ID=

# Foundation Model Identifier
# Explicitly configure an available model from your London (eu-gb) watsonx project.
# IBM lists meta-llama/llama-3-3-70b-instruct for London, but verify supported
# models in your account/runtime instance before configuring. Do not assume
# withdrawn models (e.g., granite-3-3-8b-instruct) are available.
WATSONX_MODEL_ID=

# API Version parameter (default: 2024-05-01)
WATSONX_API_VERSION=2024-05-01

# Optional generation token limit (default: 2048)
# WATSONX_MAX_TOKENS=2048

# -----------------------------------------------------------------------------
# CORS & Deployment Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of additional frontend origins (e.g. custom domain)
# Vercel deployments (*.vercel.app) and local development (localhost:3000, 5173)
# are automatically permitted.
# FRONTEND_ORIGIN=https://skillpulse.vercel.app
