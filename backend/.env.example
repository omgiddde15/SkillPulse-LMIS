# SkillPulse LMIS - Environment Configuration Example
# Smart India Hackathon 2026 - Problem Statement SIH26246
#
# Copy this file to .env and provide your local credentials.
# Do not commit real keys or credentials to version control.

# Active AI Provider: "gemini" (default) or "watsonx"
AI_PROVIDER=gemini

# Common Request Timeout Boundary (in milliseconds, bounded between 5000 and 30000)
AI_TIMEOUT_MS=20000

# -----------------------------------------------------------------------------
# Google Gemini Configuration
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=LOW

# -----------------------------------------------------------------------------
# IBM watsonx.ai Configuration (Optional Secondary Provider)
# -----------------------------------------------------------------------------
# IBM Cloud IAM API Key
WATSONX_API_KEY=

# Regional Service Endpoint (e.g., Dallas: https://us-south.ml.cloud.ibm.com)
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# watsonx.ai Project UUID
WATSONX_PROJECT_ID=

# Foundation Model Identifier (e.g., ibm/granite-3-3-8b-instruct or ibm/granite-3-8b-instruct)
WATSONX_MODEL_ID=ibm/granite-3-3-8b-instruct

# API Version parameter (default: 2024-05-01)
WATSONX_API_VERSION=2024-05-01
